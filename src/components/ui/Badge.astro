---
export interface Props {
  variant?: 'default' | 'production' | 'working' | 'exploring' | 'accent' | 'neutral';
  size?: 'sm' | 'md';
  class?: string;
}

const { variant = 'default', size = 'sm', class: customClass = '' } = Astro.props;

const variants = {
  default: 'bg-zinc-100 text-zinc-800 dark:bg-zinc-800/80 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700/60',
  production: 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border-emerald-500/20',
  working: 'bg-blue-500/10 text-blue-700 dark:text-blue-300 border-blue-500/20',
  exploring: 'bg-purple-500/10 text-purple-700 dark:text-purple-300 border-purple-500/20',
  accent: 'bg-blue-600/10 text-blue-700 dark:text-blue-400 border-blue-500/20',
  neutral: 'bg-zinc-100 text-zinc-600 dark:bg-zinc-900 dark:text-zinc-400 border-zinc-200 dark:border-zinc-800',
};

const sizes = {
  sm: 'text-xs px-2.5 py-0.5',
  md: 'text-xs px-3 py-1',
};
---

<span class={`inline-flex items-center gap-1.5 font-mono font-medium rounded-full border ${variants[variant]} ${sizes[size]} ${customClass}`}>
  <slot />
</span>
