---
import { profile } from '@/data/profile';
import Button from '@/components/ui/Button.astro';
import { ArrowRight, FileText, MapPin, Terminal } from 'lucide-react';
---

<section class="relative min-h-[85vh] flex items-center justify-center pt-8 pb-16 overflow-hidden">
  <!-- Subtle technical grid background -->
  <div class="absolute inset-0 tech-grid-light dark:tech-grid radial-mask pointer-events-none opacity-40"></div>

  <!-- Ambient light gradients -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[300px] bg-blue-500/10 dark:bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & CTAs (7 cols) -->
      <div class="lg:col-span-7 space-y-6 text-left">
        <!-- Status & Location row -->
        <div class="flex flex-wrap items-center gap-3">
          {profile.availability.isAvailable && (
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-emerald-500/10 border border-emerald-500/20 text-emerald-700 dark:text-emerald-400">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              {profile.availability.statusText}
            </div>
          )}

          <div class="inline-flex items-center gap-1.5 text-xs font-mono text-zinc-500 dark:text-zinc-400 px-2.5 py-1 rounded-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
            <MapPin className="w-3.5 h-3.5 text-blue-500" />
            <span>{profile.location}</span>
          </div>
        </div>

        <!-- Headline -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-zinc-950 dark:text-white leading-[1.12]">
          Engineering Scalable Software.<br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-indigo-500 to-purple-600 dark:from-blue-400 dark:via-indigo-300 dark:to-purple-400">
            Exploring Intelligent Systems.
          </span>
        </h1>

        <!-- Subheadline -->
        <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-2xl leading-relaxed">
          {profile.heroSubheadline}
        </p>

        <!-- Current Focus Tags -->
        <div class="pt-1 flex flex-wrap items-center gap-2 text-xs font-mono text-zinc-600 dark:text-zinc-400">
          <span class="text-zinc-400 dark:text-zinc-500">Core:</span>
          <span class="px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700/60 text-zinc-800 dark:text-zinc-200">React / Next.js</span>
          <span class="px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700/60 text-zinc-800 dark:text-zinc-200">TypeScript</span>
          <span class="px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700/60 text-zinc-800 dark:text-zinc-200">NestJS / Node</span>
          <span class="px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700/60 text-zinc-800 dark:text-zinc-200">Kafka</span>
          <span class="text-zinc-400 dark:text-zinc-500 ml-1">Direction:</span>
          <span class="px-2 py-0.5 rounded bg-purple-500/10 border border-purple-500/20 text-purple-700 dark:text-purple-300">PyTorch & LLM RAG</span>
        </div>

        <!-- Action Buttons -->
        <div class="pt-4 flex flex-wrap items-center gap-3">
          <Button href="#projects" variant="primary" size="md">
            <span>Explore My Work</span>
            <ArrowRight className="w-4 h-4 ml-1" />
          </Button>

          <Button href={profile.cvUrl} variant="outline" size="md" target="_blank" download="Subhan_Fadz_Kamil_Singandaru_CV.pdf">
            <FileText className="w-4 h-4 text-zinc-500" />
            <span>Download Resume</span>
          </Button>

          <Button href="#contact" variant="ghost" size="md">
            <span>Get in Touch</span>
          </Button>
        </div>
      </div>

      <!-- Right Column: Visual Portrait Card (5 cols) -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end">
        <div class="relative w-full max-w-sm">
          <!-- Outer decorative border frame -->
          <div class="relative p-2 rounded-2xl bg-gradient-to-b from-zinc-200 to-zinc-100 dark:from-zinc-800 dark:to-zinc-900/60 shadow-xl border border-zinc-200/80 dark:border-zinc-800">
            <div class="overflow-hidden rounded-xl bg-zinc-100 dark:bg-zinc-950 aspect-[4/5] relative group">
              <img
                src={profile.avatarUrl}
                alt={profile.name}
                class="w-full h-full object-cover grayscale-[30%] group-hover:grayscale-0 group-hover:scale-105 transition-all duration-500"
                loading="eager"
                width="400"
                height="500"
              />

              <!-- Bottom Glass Badge -->
              <div class="absolute bottom-3 inset-x-3 p-3 rounded-lg glass-panel-light dark:glass-panel flex items-center justify-between">
                <div>
                  <div class="font-semibold text-xs text-zinc-900 dark:text-zinc-100">{profile.name}</div>
                  <div class="text-[11px] font-mono text-zinc-500 dark:text-zinc-400">Software Engineer @ IFG</div>
                </div>
                <div class="w-7 h-7 rounded-md bg-blue-500/10 dark:bg-blue-400/10 flex items-center justify-center text-blue-600 dark:text-blue-400">
                  <Terminal className="w-3.5 h-3.5" />
                </div>
              </div>
            </div>
          </div>

          <!-- Subtle offset accent dot matrix -->
          <div class="absolute -top-3 -right-3 w-16 h-16 tech-grid opacity-30 pointer-events-none"></div>
        </div>
      </div>

    </div>
  </div>
</section>
