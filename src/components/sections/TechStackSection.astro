---
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Badge from '@/components/ui/Badge.astro';
import { skillCategories, tierLabels } from '@/data/skills';
import { Layers, Server, Database, Cloud, Brain } from 'lucide-react';

const getCategoryIcon = (id: string) => {
  switch (id) {
    case 'frontend':
      return Layers;
    case 'backend':
      return Server;
    case 'database':
      return Database;
    case 'devops':
      return Cloud;
    case 'ai':
      return Brain;
    default:
      return Layers;
  }
};
---

<section id="stack" class="py-20 border-t border-zinc-200 dark:border-zinc-800/80 bg-zinc-50/40 dark:bg-zinc-950/40">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <SectionHeader
      eyebrow="Technical Capabilities"
      title="Technology Stack & Proficiency Matrix"
      description="Categorized by engineering discipline with transparent distinction between production delivery, working knowledge, and active research."
    />

    <!-- Transparent Tier Legend -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 mb-12">
      <div class="p-4 rounded-xl bg-white dark:bg-zinc-900/60 border border-emerald-500/20 space-y-1">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span class="font-mono text-xs font-semibold text-emerald-600 dark:text-emerald-400">
            {tierLabels.production.label}
          </span>
        </div>
        <p class="text-xs text-zinc-600 dark:text-zinc-400">
          {tierLabels.production.description}
        </p>
      </div>

      <div class="p-4 rounded-xl bg-white dark:bg-zinc-900/60 border border-blue-500/20 space-y-1">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-blue-500"></span>
          <span class="font-mono text-xs font-semibold text-blue-600 dark:text-blue-400">
            {tierLabels.working.label}
          </span>
        </div>
        <p class="text-xs text-zinc-600 dark:text-zinc-400">
          {tierLabels.working.description}
        </p>
      </div>

      <div class="p-4 rounded-xl bg-white dark:bg-zinc-900/60 border border-purple-500/20 space-y-1">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-purple-500"></span>
          <span class="font-mono text-xs font-semibold text-purple-600 dark:text-purple-400">
            {tierLabels.exploring.label}
          </span>
        </div>
        <p class="text-xs text-zinc-600 dark:text-zinc-400">
          {tierLabels.exploring.description}
        </p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8">
      {skillCategories.map((category) => {
        const IconComponent = getCategoryIcon(category.id);
        return (
          <div class="p-6 sm:p-8 rounded-2xl bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800/80 shadow-sm space-y-5">
            <!-- Category Title Row -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-4 border-b border-zinc-100 dark:border-zinc-800/60">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-zinc-900 dark:text-zinc-100">
                  <IconComponent className="w-4 h-4 text-blue-500" />
                </div>
                <div>
                  <h3 class="font-bold text-base sm:text-lg text-zinc-950 dark:text-white">
                    {category.name}
                  </h3>
                  <p class="text-xs text-zinc-500 dark:text-zinc-400">
                    {category.description}
                  </p>
                </div>
              </div>
            </div>

            <!-- Skills Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
              {category.skills.map((skill) => (
                <div class="p-3.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/40 border border-zinc-200/60 dark:border-zinc-800/60 flex flex-col justify-between gap-2 group hover:border-zinc-300 dark:hover:border-zinc-700 transition-colors">
                  <div class="flex items-center justify-between gap-2">
                    <span class="font-semibold text-xs sm:text-sm text-zinc-900 dark:text-zinc-100">
                      {skill.name}
                    </span>
                    <Badge variant={skill.tier} size="sm">
                      {skill.tier === 'production' ? 'Production' : skill.tier === 'working' ? 'Working' : 'Exploring'}
                    </Badge>
                  </div>
                  <p class="text-[11px] text-zinc-500 dark:text-zinc-400 leading-snug">
                    {skill.context}
                  </p>
                </div>
              ))}
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>
