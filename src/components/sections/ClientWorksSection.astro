---
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { clientWorks } from '@/data/client-works';
import { ExternalLink, Globe, MapPin, Calendar } from 'lucide-react';
---

<section id="client-work" class="py-20 border-t border-zinc-200 dark:border-zinc-800/80">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <SectionHeader
      eyebrow="Commercial Deliveries"
      title="Client Work & Production Deployments"
      description="Production websites crafted and delivered for business owners, healthcare practices, and hospitality brands."
    />

    <div class="space-y-8">
      {clientWorks.map((work) => (
        <article class="group rounded-2xl bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800/80 overflow-hidden shadow-sm hover:shadow-lg hover:border-zinc-300 dark:hover:border-zinc-700 transition-all duration-300">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-0">
            {/* Visual Preview / Screenshot */}
            <div class="lg:col-span-6 relative aspect-[16/10] overflow-hidden bg-zinc-100 dark:bg-zinc-800/50 border-b lg:border-b-0 lg:border-r border-zinc-200 dark:border-zinc-800/80">
              <img
                src={work.image}
                alt={`Screenshot of ${work.title}`}
                loading="lazy"
                class="w-full h-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none" />
            </div>

            {/* Content Details */}
            <div class="lg:col-span-6 p-6 sm:p-8 flex flex-col justify-between">
              <div class="space-y-4">
                {/* Meta details */}
                <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs font-mono text-zinc-500 dark:text-zinc-400">
                  <span class="inline-flex items-center gap-1.5 text-blue-600 dark:text-blue-400 font-medium">
                    <Globe className="w-3.5 h-3.5" />
                    {work.scope}
                  </span>
                  <span class="inline-flex items-center gap-1">
                    <MapPin className="w-3.5 h-3.5" />
                    {work.location}
                  </span>
                  <span class="inline-flex items-center gap-1">
                    <Calendar className="w-3.5 h-3.5" />
                    {work.year}
                  </span>
                </div>

                {/* Title & Tagline */}
                <div>
                  <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-950 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                    {work.title}
                  </h3>
                  <p class="text-xs sm:text-sm font-medium text-zinc-500 dark:text-zinc-400 mt-1">
                    {work.tagline}
                  </p>
                </div>

                {/* Description */}
                <p class="text-sm text-zinc-700 dark:text-zinc-300 leading-relaxed">
                  {work.description}
                </p>
              </div>

              {/* Bottom: Stack & Action */}
              <div class="pt-6 mt-6 border-t border-zinc-100 dark:border-zinc-800/60 flex flex-wrap items-center justify-between gap-4">
                <div class="flex flex-wrap items-center gap-1.5">
                  {work.technologies.map((tech) => (
                    <span class="px-2.5 py-1 rounded text-[11px] font-mono bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-200/60 dark:border-zinc-700/60">
                      {tech}
                    </span>
                  ))}
                </div>

                <a
                  href={work.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-mono font-medium bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-950 hover:bg-blue-600 dark:hover:bg-blue-500 dark:hover:text-white transition-colors"
                >
                  <span>Visit Website</span>
                  <ExternalLink className="w-3.5 h-3.5" />
                </a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
