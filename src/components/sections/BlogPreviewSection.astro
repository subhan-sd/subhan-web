---
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Button from '@/components/ui/Button.astro';
import { getCollection } from 'astro:content';
import { Calendar, Clock, ArrowRight } from 'lucide-react';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);
---

<section id="blog-preview" class="py-20 border-t border-zinc-200 dark:border-zinc-800/80 bg-zinc-50/30 dark:bg-zinc-950/30">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12">
      <SectionHeader
        eyebrow="Technical Writing"
        title="Engineering Insights & Notes"
        description="Deep dives into software architecture, distributed systems, and real-world AI engineering transitions."
        class="mb-0"
      />
      <Button href="/blog" variant="outline" size="sm" class="self-start sm:self-end">
        <span>View All Articles</span>
        <ArrowRight className="w-4 h-4 ml-1" />
      </Button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {recentPosts.map((post) => (
        <a
          href={`/blog/${post.slug}`}
          class="p-6 rounded-2xl bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800/80 shadow-sm hover:shadow-md hover:border-zinc-300 dark:hover:border-zinc-700 transition-all duration-300 flex flex-col justify-between group"
        >
          <div class="space-y-3">
            <!-- Meta row -->
            <div class="flex items-center gap-3 text-xs font-mono text-zinc-500 dark:text-zinc-400">
              <span class="px-2 py-0.5 rounded bg-blue-500/10 text-blue-700 dark:text-blue-400 border border-blue-500/20">
                {post.data.category}
              </span>
              <div class="flex items-center gap-1">
                <Calendar className="w-3.5 h-3.5" />
                <span>{post.data.publishDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
              </div>
              <div class="flex items-center gap-1">
                <Clock className="w-3.5 h-3.5" />
                <span>{post.data.readingTime}</span>
              </div>
            </div>

            <!-- Title -->
            <h3 class="text-lg sm:text-xl font-bold text-zinc-950 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors leading-snug">
              {post.data.title}
            </h3>

            <!-- Description -->
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
              {post.data.description}
            </p>
          </div>

          <!-- Bottom tags -->
          <div class="pt-4 mt-4 border-t border-zinc-100 dark:border-zinc-800/60 flex items-center justify-between">
            <div class="flex flex-wrap items-center gap-1.5">
              {post.data.tags.slice(0, 3).map((tag) => (
                <span class="text-[11px] font-mono text-zinc-500 dark:text-zinc-400">
                  #{tag}
                </span>
              ))}
            </div>
            <span class="inline-flex items-center gap-1 text-xs font-mono font-medium text-blue-600 dark:text-blue-400 group-hover:translate-x-0.5 transition-transform">
              <span>Read Post</span>
              <ArrowRight className="w-3.5 h-3.5" />
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
