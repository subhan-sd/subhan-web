---
import { profile } from '@/data/profile';
import { navLinks } from '@/data/navigation';
import { ArrowUpRight, Cpu } from 'lucide-react';
---

<footer class="w-full border-t border-zinc-200 dark:border-zinc-800/80 bg-zinc-50 dark:bg-zinc-950/50 py-12 px-4 sm:px-6 transition-colors">
  <div class="max-w-6xl mx-auto space-y-10">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Col 1: Brand & Positioning -->
      <div class="md:col-span-2 space-y-3">
        <div class="flex items-center gap-2.5">
          <div class="w-6 h-6 rounded bg-zinc-900 text-white dark:bg-white dark:text-zinc-950 flex items-center justify-center font-mono font-bold text-[10px]">
            SK
          </div>
          <span class="font-bold text-sm tracking-tight text-zinc-900 dark:text-zinc-100">
            {profile.name}
          </span>
        </div>
        <p class="text-sm text-zinc-600 dark:text-zinc-400 max-w-md leading-relaxed">
          {profile.positioning}
        </p>
        <div class="flex items-center gap-2 pt-2 text-xs font-mono text-zinc-500">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Bogor, ID (WIB / UTC+7)</span>
          <span class="text-zinc-400">•</span>
          <span id="footer-live-time">--:-- WIB</span>
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="space-y-3">
        <h4 class="font-mono text-xs uppercase tracking-wider font-semibold text-zinc-900 dark:text-zinc-200">
          Navigation
        </h4>
        <ul class="space-y-2 text-sm text-zinc-600 dark:text-zinc-400">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-zinc-950 dark:hover:text-zinc-100 transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Connect & Platform -->
      <div class="space-y-3">
        <h4 class="font-mono text-xs uppercase tracking-wider font-semibold text-zinc-900 dark:text-zinc-200">
          Connect
        </h4>
        <ul class="space-y-2 text-sm text-zinc-600 dark:text-zinc-400">
          <li>
            <a
              href={profile.contacts.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 hover:text-zinc-950 dark:hover:text-zinc-100 transition-colors"
            >
              <span>GitHub</span>
              <ArrowUpRight className="w-3.5 h-3.5 text-zinc-400" />
            </a>
          </li>
          <li>
            <a
              href={profile.contacts.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 hover:text-zinc-950 dark:hover:text-zinc-100 transition-colors"
            >
              <span>LinkedIn</span>
              <ArrowUpRight className="w-3.5 h-3.5 text-zinc-400" />
            </a>
          </li>
          <li>
            <a
              href={`mailto:${profile.contacts.email}`}
              class="inline-flex items-center gap-1.5 hover:text-zinc-950 dark:hover:text-zinc-100 transition-colors"
            >
              <span>Email</span>
              <ArrowUpRight className="w-3.5 h-3.5 text-zinc-400" />
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-6 border-t border-zinc-200 dark:border-zinc-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-zinc-500">
      <div class="flex items-center gap-2">
        <Cpu className="w-3.5 h-3.5 text-blue-500" />
        <span>Deployed on Cloudflare Workers &bull; Built with Astro & TypeScript</span>
      </div>
      <div>
        &copy; {new Date().getFullYear()} {profile.name}. All rights reserved.
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  function updateTime() {
    const el = document.getElementById('footer-live-time');
    if (!el) return;
    try {
      const now = new Date();
      const options = { timeZone: 'Asia/Jakarta', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false };
      el.textContent = `${new Intl.DateTimeFormat('en-GB', options).format(now)} WIB`;
    } catch (e) {
      // fallback
    }
  }
  updateTime();
  setInterval(updateTime, 1000);
</script>
